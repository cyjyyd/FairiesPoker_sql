<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="protobuf-net" Version="3.0.0" />
    <PackageReference Include="SpriteFontPlus" Version="0.7.1.24" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FairiesPoker\Protocol\Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\FairiesPoker\Resources\main seq.jpg" Link="Resources\main seq.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\ChatHall1.jpg" Link="Resources\ChatHall1.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\backIMG.png" Link="Resources\backIMG.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\AppIcon.png" Link="Resources\AppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\Pla.jpg" Link="Resources\Pla.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\FP.png" Link="Resources\FP.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\FPR.png" Link="Resources\FPR.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\prf.jpg" Link="Resources\prf.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Resources\*.wav" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_TB\**\*.*" Link="UI_TB\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_LT\**\*.*" Link="UI_LT\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_FR\**\*.*" Link="UI_FR\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_SW\**\*.*" Link="UI_SW\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_PF\**\*.*" Link="UI_PF\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_LN\**\*.*" Link="UI_LN\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Pokers\**\*.*" Link="Pokers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Results\**\*.*" Link="Results\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Fonts\**\*.*" Link="Fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="FontTest\**" />
    <None Include="FontTest\**" />
  </ItemGroup>
  <Target Name="CreateMacOSAppBundle" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
    <PropertyGroup>
      <MacOSAppBundleDir>$(PublishDir)FairiesPoker.app</MacOSAppBundleDir>
    </PropertyGroup>
    <ItemGroup>
      <MacOSAppSourceFiles Include="$(PublishDir)**\*" Exclude="$(MacOSAppBundleDir)\**\*" />
      <MacOSAppDirectories Include="@(MacOSAppSourceFiles->'$(MacOSAppBundleDir)\Contents\MacOS\%(RecursiveDir)')" />
    </ItemGroup>
    <RemoveDir Directories="$(MacOSAppBundleDir)" />
    <MakeDir Directories="$(MacOSAppBundleDir)\Contents\MacOS;$(MacOSAppBundleDir)\Contents\Resources;@(MacOSAppDirectories)" />
    <Copy SourceFiles="@(MacOSAppSourceFiles)" DestinationFiles="@(MacOSAppSourceFiles->'$(MacOSAppBundleDir)\Contents\MacOS\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="MacOS\Info.plist" DestinationFiles="$(MacOSAppBundleDir)\Contents\Info.plist" />
    <Copy SourceFiles="MacOS\FairiesPoker.icns" DestinationFiles="$(MacOSAppBundleDir)\Contents\Resources\FairiesPoker.icns" />
  </Target>
</Project>
