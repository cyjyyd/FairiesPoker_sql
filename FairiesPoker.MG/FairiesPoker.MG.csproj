<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0-android</TargetFrameworks>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.cyjyyd.fairiespoker</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>Android\AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="SpriteFontPlus" Version="0.7.1.24" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FairiesPoker\Protocol\Protocol.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <Content Include="..\FairiesPoker\Resources\**\*.*" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_TB\**\*.*" Link="UI_TB\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_LT\**\*.*" Link="UI_LT\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_FR\**\*.*" Link="UI_FR\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_SW\**\*.*" Link="UI_SW\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_PF\**\*.*" Link="UI_PF\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\UI_LN\**\*.*" Link="UI_LN\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Pokers\**\*.*" Link="Pokers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\FairiesPoker\Results\**\*.*" Link="Results\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Fonts\**\*.*" Link="Fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="FontTest\**" />
    <None Include="FontTest\**" />
    <Compile Remove="Android\**\*.cs" Condition="'$(TargetFramework)' == 'net9.0'" />
    <Compile Remove="Program.cs" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <Compile Remove="Core\WindowIconManager.cs" Condition="'$(TargetFramework)' == 'net10.0-android'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidResource Include="Android\Resources\**\*.*" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\Resources\**\*.*" Exclude="..\FairiesPoker\Resources\捕获.PNG;..\FairiesPoker\Resources\图层 46814644561761.png" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\Resources\捕获.PNG" Link="Resources\capture.png" />
    <AndroidAsset Include="..\FairiesPoker\Resources\图层 46814644561761.png" Link="Resources\layer-46814644561761.png" />
    <AndroidAsset Include="..\FairiesPoker\UI_TB\**\*.*" Link="UI_TB\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\UI_LT\**\*.*" Link="UI_LT\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\UI_FR\**\*.*" Link="UI_FR\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\UI_SW\**\*.*" Link="UI_SW\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\UI_PF\**\*.*" Link="UI_PF\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\UI_LN\**\*.*" Link="UI_LN\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\Pokers\**\*.*" Exclude="..\FairiesPoker\Pokers\牌背3.png;..\FairiesPoker\Pokers\5\牌背.png;..\FairiesPoker\Pokers\5\牌背2.png;..\FairiesPoker\Pokers\5\牌背3.png" Link="Pokers\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\FairiesPoker\Pokers\牌背3.png" Link="Pokers\card-back-3.png" />
    <AndroidAsset Include="..\FairiesPoker\Pokers\5\牌背.png" Link="Pokers\5\card-back.png" />
    <AndroidAsset Include="..\FairiesPoker\Pokers\5\牌背2.png" Link="Pokers\5\card-back-2.png" />
    <AndroidAsset Include="..\FairiesPoker\Pokers\5\牌背3.png" Link="Pokers\5\card-back-3.png" />
    <AndroidAsset Include="..\FairiesPoker\Results\**\*.*" Link="Results\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="Fonts\**\*.*" Link="Fonts\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CreateMacOSAppBundle" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
    <PropertyGroup>
      <MacOSAppBundleDir>$(PublishDir)FairiesPoker.app</MacOSAppBundleDir>
    </PropertyGroup>
    <ItemGroup>
      <MacOSAppSourceFiles Include="$(PublishDir)**\*" Exclude="$(MacOSAppBundleDir)\**\*" />
      <MacOSAppDirectories Include="@(MacOSAppSourceFiles->'$(MacOSAppBundleDir)\Contents\MacOS\%(RecursiveDir)')" />
    </ItemGroup>
    <RemoveDir Directories="$(MacOSAppBundleDir)" />
    <MakeDir Directories="$(MacOSAppBundleDir)\Contents\MacOS;$(MacOSAppBundleDir)\Contents\Resources;@(MacOSAppDirectories)" />
    <Copy SourceFiles="@(MacOSAppSourceFiles)" DestinationFiles="@(MacOSAppSourceFiles->'$(MacOSAppBundleDir)\Contents\MacOS\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="MacOS\Info.plist" DestinationFiles="$(MacOSAppBundleDir)\Contents\Info.plist" />
    <Copy SourceFiles="MacOS\FairiesPoker.icns" DestinationFiles="$(MacOSAppBundleDir)\Contents\Resources\FairiesPoker.icns" />
  </Target>
</Project>
